# -----------------------------------------------------------------------------
# Grok eToro dashboard — environment configuration
# Copy to .env for local development. All values are optional in mock mode.
# -----------------------------------------------------------------------------

# Server
PORT=3000
SESSION_SECRET=dev-only-change-me

# Data source: "mock" (default) serves representative fixtures so the app runs
# end-to-end without eToro credentials. "live" calls the real eToro Public API.
ETORO_MODE=mock

# Trading environment for live mode: "demo" (paper) or "real".
ETORO_ENV=demo

# --- Live mode: SSO ("Sign in with eToro") ---
# Register an app at https://api-portal.etoro.com/ to obtain these.
ETORO_CLIENT_ID=
ETORO_CLIENT_SECRET=
ETORO_REDIRECT_URI=http://localhost:3000/api/auth/etoro/callback

# --- Live mode: partner API-key auth (alternative to SSO) ---
# Never send API keys AND a Bearer token together — pick one auth family.
ETORO_API_KEY=
ETORO_USER_KEY=
